include .python-version config.example.toml AGENTS.md CHANGELOG.md
recursive-include packaging *.rb *.md *.json
recursive-include packaging *.txt
recursive-include tools *.py
recursive-include tests *.py
recursive-include docs *.md
recursive-include src/bibdesk_rag/resources *.txt *.toml
prune .local
prune .git
prune .codex
prune .agents
prune .build-wheels
prune .brew-cache
global-exclude __pycache__ *.py[cod] *.sqlite* *.db* config.toml
